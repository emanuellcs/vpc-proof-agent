# =============================================================
# vpc-proof-agent — .env.example
# Documented placeholders for future configuration commits.
# Copy to `.env` for local runs (`.env` is gitignored).
# NEVER commit real credentials. The agent never reads or exposes
# AWS credentials at runtime.
# =============================================================

# HTTP server listen address for the public REST API.
VPC_PROOF_HTTP_ADDR=:8080

# Structured logging: "json" or "text".
VPC_PROOF_LOG_LEVEL=info
VPC_PROOF_LOG_FORMAT=json

# Token used to authenticate REST API requests (rate limiting + auth).
VPC_PROOF_API_TOKEN=change-me

# Rate limiting: max requests per window (seconds) per client.
VPC_PROOF_RATE_LIMIT_REQUESTS=100
VPC_PROOF_RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTL (seconds) for expensive network probes.
VPC_PROOF_CACHE_TTL_SECONDS=300

# EC2 metadata endpoints (IMDSv2).
VPC_PROOF_IMDS_BASE_URL=http://169.254.169.254

# External echo service used for public IP consistency checks.
VPC_PROOF_ECHO_URL=https://checkip.amazonaws.com
