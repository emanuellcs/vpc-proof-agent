# =============================================================
# vpc-proof-agent — .env.example
# Documented environment variables for local runs (copy to `.env`
# if your tooling loads it; the agent itself reads the process env).
#
# Precedence: command-line flags > environment variables > config
# file (YAML) > defaults. NEVER commit real credentials. The agent
# never reads or exposes AWS credentials at runtime.
# =============================================================

# Path to a YAML configuration file (also settable via --config flag).
VPC_PROOF_CONFIG=

# --- server ---
VPC_PROOF_SERVER_ADDR=0.0.0.0
VPC_PROOF_SERVER_PORT=8080
VPC_PROOF_SERVER_READ_TIMEOUT=10s
VPC_PROOF_SERVER_WRITE_TIMEOUT=10s
VPC_PROOF_SERVER_IDLE_TIMEOUT=60s
VPC_PROOF_SERVER_SHUTDOWN_TIMEOUT=10s
# Set both to enable HTTPS serving.
VPC_PROOF_SERVER_TLS_CERT_FILE=
VPC_PROOF_SERVER_TLS_KEY_FILE=

# --- auth ---
VPC_PROOF_AUTH_ENABLED=false
VPC_PROOF_AUTH_TOKEN=change-me

# --- probes ---
VPC_PROOF_PROBES_VPC_CIDR=10.0.0.0/16
VPC_PROOF_PROBES_SUBNET_CIDR=10.0.1.0/24
VPC_PROOF_PROBES_ECHO_URLS=https://checkip.amazonaws.com
VPC_PROOF_PROBES_DNS_HOST=amazon.com
VPC_PROOF_PROBES_TIMEOUT=5s
VPC_PROOF_PROBES_MAX_RETRIES=2

# --- cache ---
VPC_PROOF_CACHE_PROBE_TTL=5m

# --- ratelimit ---
VPC_PROOF_RATELIMIT_REQUESTS_PER_MINUTE=100
VPC_PROOF_RATELIMIT_BURST=20

# --- history ---
VPC_PROOF_HISTORY_MAX_ENTRIES=50
VPC_PROOF_HISTORY_DISK_PATH=
VPC_PROOF_HISTORY_FLUSH_INTERVAL=30s

# --- log ---
VPC_PROOF_LOG_LEVEL=info
VPC_PROOF_LOG_FORMAT=json
