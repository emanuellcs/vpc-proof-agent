# =============================================================
# vpc-proof-agent — .gitignore
# Covers Go tooling, LocalStack, IDEs, OS files, and build output.
# =============================================================

# --- Go: binaries and plugins ---
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries, built with `go test -c`
*.test

# --- Go: coverage and analysis artifacts ---
*.out
coverage.*
*.coverprofile
profile.cov
*.cover

# --- Go: dependency directories and workspaces ---
# vendor/
go.work
go.work.sum

# --- Build output ---
/bin/
/dist/
/build/

# --- Environment files (keep the example template) ---
.env
.env.*
!.env.example

# --- LocalStack ---
.localstack/
localstack-data/
lstk/
localstack*.log
# Generated resource IDs file written by scripts/setup-localstack.sh
scripts/.localstack-resources.env

# --- IDE / editor ---
.idea/
.vscode/
*.iml

# --- OS-specific ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
